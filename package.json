{
  "name": "beauty-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "knowledge:candidate": "node --conditions=react-server --import tsx scripts/knowledge-candidate.ts",
    "knowledge:data-boundary": "vitest run tests/unit/product-decision/data-boundary-validation.test.ts --reporter=verbose",
    "knowledge:review": "node --conditions=react-server --import tsx scripts/knowledge-review.ts",
    "knowledge:seed": "node --conditions=react-server --env-file=.env.local --import tsx scripts/knowledge-seed.ts",
    "product-knowledge:validate": "node --conditions=react-server --import tsx scripts/product-knowledge-import.ts validate",
    "product-knowledge:import": "node --conditions=react-server --import tsx scripts/product-knowledge-import.ts import",
    "test:integration:rls": "vitest run tests/integration/rls --no-file-parallelism --hookTimeout 30000 --testTimeout 30000"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.19.0"
}
