# Public Supabase project configuration.
# Copy this file to .env.local and replace the placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Set one email address to restrict this personal app to one user.
AUTH_ALLOWED_EMAIL=

# Optional integration-test project. Use two disposable, pre-created users.
# Tests authenticate as ordinary users and never use a service-role key.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
