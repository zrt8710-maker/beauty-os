# Public Supabase project configuration.
# Copy this file to .env.local and replace the placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only privileged credential for trusted production admin workflows.
# Never prefix it with NEXT_PUBLIC_, expose it to browser code, or commit a real key.
# Configure each deployed environment separately; tests use the test-only key below.
SUPABASE_SERVICE_ROLE_KEY=

# Public signup is enabled. The retired AUTH_ALLOWED_EMAIL is ignored.
# Production: replace NEXT_PUBLIC_APP_URL above with the stable HTTPS deployment URL.

# Optional server-only provider for Product Recognition. When absent or unavailable,
# recognition safely falls back to Catalog lookup and the existing unknown flow.
OPENAI_API_KEY=
OPENAI_PRODUCT_RECOGNITION_MODEL=gpt-4.1-mini

# Optional server-only, stateless daily Skin Conversation Extractor. It uses
# structured output and store:false; provider memory is never enabled.
OPENAI_SKIN_CONVERSATION_MODEL=gpt-4.1-mini

# V1 is explicit and defaults to Volcengine when unset. Supported: volcengine, openai.
# Select openai only in an environment that also configures OPENAI_API_KEY.
SKIN_CONVERSATION_PROVIDER=volcengine

# Optional Alibaba Cloud Bailian recognition adapter. Both values are required
# to enable it. The selected BAILIAN_MODEL must support the supplied modality.
BAILIAN_API_KEY=
BAILIAN_MODEL=

# Shared server-only AI provider used by Planner, narration and conversations.
VOLCENGINE_AGENT_PLAN_KEY=
VOLCENGINE_AGENT_PLAN_MODEL=doubao-seed-2.1-turbo
VOLCENGINE_AGENT_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3/responses

# Optional integration-test project. Use two disposable, pre-created users.
# Most tests authenticate as ordinary users. The optional curation transaction
# tests use only this disposable project's service-role key.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
